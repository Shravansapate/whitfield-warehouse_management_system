ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://wms_app:<password>@127.0.0.1:5432/whitfield_wms
TEST_DATABASE_URL=postgresql+asyncpg://wms_test:<password>@127.0.0.1:5432/whitfield_wms_test
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-characters>
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CARRIER_PROVIDER=fake
FAKE_CARRIER_BASE_URL=http://127.0.0.1:8000/dev-labels
LOW_STOCK_SCHEDULER_ENABLED=false
LOW_STOCK_SCHEDULER_INTERVAL_SECONDS=900
LOW_STOCK_SCHEDULER_RUN_IMMEDIATELY=true
SEED_OWNER_NAME=Whitfield Owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=<choose-a-strong-development-password>

# Voice AI assistant (both are optional — the backend starts without them)
# Without DEEPGRAM_API_KEY: voice assistant runs in text-only mode (type instead of speak)
# Without GEMINI_API_KEY: voice assistant replies with a setup message
DEEPGRAM_API_KEY=<your-deepgram-api-key>
GEMINI_API_KEY=<your-google-gemini-api-key>
